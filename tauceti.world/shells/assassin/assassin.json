{
  "name": "Assassin",
  "abilities": [
    {
      "name": "ROLE: Shadow agent",
      "type": "TECH: Invisibility systems ",
      "icon": {
        "url": "https://assets.thecdn.io/16e37775-25cf-43ef-8854-791616b32629.png",
        "filename": "16e37775-25cf-43ef-8854-791616b32629.png",
