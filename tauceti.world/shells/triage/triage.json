{
  "name": "Triage",
  "abilities": [
    {
      "name": "ROLE: Field medic ",
      "type": "TECH: Damage mitigation ",
      "icon": {
        "url": "https://assets.thecdn.io/290eabc0-3aa2-4f24-8611-111b06cd6b86.png",
        "filename": "290eabc0-3aa2-4f24-8611-111b06cd6b86.png",
        "alt_filename": "290eabc0-3aa2-4f24-8611-111b06cd6b86.png",
        "alt": "Triage Icon",
        "width": 108,
        "height": 108,
        "mimeType": "image/png"
      },
      "heading": "Triage saves lives. ",
      "description": "Deployable healing drones and onboard reboot abilities allow Triage Runners and their crews  to keep running after taking damage. Mend health and shields and even reboot crewmates at a distance to survive and fight again and again. \n[excerpt, UESC threat eval: rnnr.trge.fileID70064c_p392] \n"
    },
    {
      "name": "REBOOT+",
      "type": "Prime Ability",
      "icon": {
        "url": "https://assets.thecdn.io/cdb1cbec-86b4-4015-ac70-ec845e7598e5.png",
        "filename": "cdb1cbec-86b4-4015-ac70-ec845e7598e5.png",
        "alt_filename": "Reboot.png",
        "alt": "Reboot",
        "width": 108,
        "height": 108,
        "mimeType": "image/png"
      },
      "heading": "",
      "description": "Ready your shell's emergency defibrillator systems.\n\nLock on to downed crew members or hostile targets and fire your Reboot+ device at them, which revives crew members and EMPs hostiles."
    },
    {
      "name": "MED-DRONE",
      "type": "Tactical Ability",
      "icon": {
        "url": "https://assets.thecdn.io/7def7591-0dd0-4749-a5db-efe35fa3f44e.png",
        "filename": "7def7591-0dd0-4749-a5db-efe35fa3f44e.png",
        "alt_filename": "Med-drone.png",
        "alt": "Med-drone",
        "width": 108,
        "height": 108,
        "mimeType": "image/png"
      },
      "heading": "",
      "description": "Deploy a floating medical drone that attaches to crew members and restores health or recharges shields, and prevents them from bleeding out while downed."
    },
    {
      "name": "SHAREWARE.EXE",
      "type": "Trait 1",
      "icon": {
        "url": "https://assets.thecdn.io/b7284fb8-6490-4ed6-8588-914891ca2243.png",
        "filename": "b7284fb8-6490-4ed6-8588-914891ca2243.png",
        "alt_filename": " Shareware.png",
        "alt": "Shareware",
        "width": 108,
        "height": 108,
        "mimeType": "image/png"
      },
      "heading": "",
      "description": "Benefits from medical consumables are shared between crew members with Med-Drone attached to them."
    },
    {
      "name": "BATTERY OVERCHARGE",
      "type": "Trait 2",
      "icon": {
        "url": "https://assets.thecdn.io/7a84a39f-fc55-4d60-8284-4969665374ff.png",
        "filename": "7a84a39f-fc55-4d60-8284-4969665374ff.png",
        "alt_filename": "Battery_overcharge.png",
        "alt": "Battery_overcharge",
        "width": 108,
        "height": 108,
        "mimeType": "image/png"
      },
      "heading": "",
      "description": "Divert energy from your cooling systems to boost the performance of your weapons at the cost of generating additional heat.\n\nWhile active, breaking a target's shield with a volt weapon EMPs them."
    }
  ],
